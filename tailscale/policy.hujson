// Zugriffsregeln des Tailnets (ADR 0001, docs/tailscale.md).
//
// Diese Datei ist die einzige Quelle: Die GitHub Action
// (.github/workflows/tailscale-acl.yml) testet sie bei Pull Requests und
// spielt sie bei main ein. Änderungen in der Admin-Konsole werden dabei
// überschrieben.
//
// Grundsatz: Erlaubt ist nur, was hier steht. Alles andere ist verboten.
// Achtung: ufw filtert den Verkehr über tailscale0 nicht, Tailscale lässt ihn
// vorher durch. Diese Policy ist also die Firewall im Tailnet.
{
	// Tags vergeben darf nur ein Admin des Tailnets (Auth-Keys mit Tag).
	"tagOwners": {
		// Der Pi mit dem Cloud-Speicher (Rolle tailscale).
		"tag:cloud": ["autogroup:admin"],
		// Der Windows-PC im anderen Haus mit dem rest-server
		// (windows/backup-ziel.ps1, docs/backup-ziel.md).
		"tag:backup-target": ["autogroup:admin"],
	},

	"grants": [
		// Meine eigenen Geräte dürfen alles.
		{
			"src": ["autogroup:member"],
			"dst": ["*"],
			"ip":  ["*"],
		},
		// Geteilte Benutzer (Node Sharing) erreichen nur den Cloud-Speicher
		// über HTTPS. SSH und alles andere bleibt für sie unsichtbar.
		{
			"src": ["autogroup:shared"],
			"dst": ["tag:cloud"],
			"ip":  ["tcp:443"],
		},
		// Der Pi erreicht auf dem Backup-Ziel nur den rest-server (ADR 0003).
		// Der Port steht auch in windows/backup-ziel.ps1 (-Port).
		{
			"src": ["tag:cloud"],
			"dst": ["tag:backup-target"],
			"ip":  ["tcp:8000"],
		},
		// Sonst erreichen tag:cloud und tag:backup-target nichts.
	],

	// Kein Tailscale SSH: SSH läuft nur über das LAN (docs/server-setup.md).
	// Ohne Abschnitt "ssh" ist es abgeschaltet.

	// Wird beim Testen und Einspielen geprüft. Ein Fehlschlag verhindert das
	// Einspielen. Eigene Geräte und geteilte Benutzer lassen sich hier nicht
	// testen, ohne eine E-Mail-Adresse ins öffentliche Repo zu schreiben.
	"tests": [
		{
			// Der Pi erreicht den rest-server auf dem Backup-Ziel (nur TCP).
			"src":    "tag:cloud",
			"proto":  "tcp",
			"accept": ["tag:backup-target:8000"],
		},
		{
			// Sonst erreicht er auf dem Backup-Ziel nichts, weder SSH, SMB,
			// RDP, WinRM noch andere Ports, und sich selbst gar nicht.
			"src":  "tag:cloud",
			"deny": [
				"tag:backup-target:22",
				"tag:backup-target:445",
				"tag:backup-target:3389",
				"tag:backup-target:5985",
				"tag:backup-target:8001",
				"tag:cloud:22",
				"tag:cloud:443",
			],
		},
		{
			// Das Backup-Ziel erreicht nichts, auch den Pi nicht.
			"src":  "tag:backup-target",
			"deny": ["tag:cloud:22", "tag:cloud:443", "tag:backup-target:8000"],
		},
	],
}
