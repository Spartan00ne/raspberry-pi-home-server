{
  "uid": "raspberry-pi",
  "title": "Raspberry Pi – Live-Monitoring",
  "description": "Live-Zustand des Raspberry Pi 4, der koffler-online.de betreibt. Prometheus, node_exporter, cAdvisor und blackbox_exporter.",
  "tags": ["raspberry-pi", "prometheus"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {"refresh_intervals": ["30s", "1m", "5m", "15m"]},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Website",
      "gridPos": {"h": 4, "w": 3, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "min(probe_success)", "instant": true}],
      "fieldConfig": {"defaults": {
        "mappings": [{"type": "value", "options": {"0": {"text": "Offline", "color": "red"}, "1": {"text": "Online", "color": "green"}}}],
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
      }, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2, "type": "stat", "title": "CPU-Temperatur",
      "gridPos": {"h": 4, "w": 3, "x": 3, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max(node_thermal_zone_temp)"}],
      "fieldConfig": {"defaults": {
        "unit": "celsius", "decimals": 1,
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 65}, {"color": "red", "value": 75}]}
      }, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 3, "type": "stat", "title": "CPU-Auslastung",
      "gridPos": {"h": 4, "w": 3, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))"}],
      "fieldConfig": {"defaults": {
        "unit": "percent", "decimals": 0, "min": 0, "max": 100,
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}
      }, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 4, "type": "stat", "title": "Arbeitsspeicher",
      "gridPos": {"h": 4, "w": 3, "x": 9, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)"}],
      "fieldConfig": {"defaults": {
        "unit": "percent", "decimals": 0, "min": 0, "max": 100,
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]}
      }, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 5, "type": "stat", "title": "SD-Karte belegt",
      "gridPos": {"h": 4, "w": 3, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})", "instant": true}],
      "fieldConfig": {"defaults": {
        "unit": "percent", "decimals": 0, "min": 0, "max": 100,
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 85}, {"color": "red", "value": 95}]}
      }, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 6, "type": "stat", "title": "Stromversorgung",
      "gridPos": {"h": 4, "w": 3, "x": 15, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max(pi_throttled_flag{flag=~\"under_voltage|throttled\"})", "instant": true}],
      "fieldConfig": {"defaults": {
        "mappings": [{"type": "value", "options": {"0": {"text": "Stabil", "color": "green"}, "1": {"text": "Unterspannung", "color": "red"}}}],
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
      }, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 7, "type": "stat", "title": "Laufzeit",
      "gridPos": {"h": 4, "w": 3, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "time() - node_boot_time_seconds", "instant": true}],
      "fieldConfig": {"defaults": {
        "unit": "s", "decimals": 0,
        "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
      }, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 8, "type": "stat", "title": "Aktive Alarme",
      "gridPos": {"h": 4, "w": 3, "x": 21, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "count(ALERTS{alertstate=\"firing\", severity!=\"info\"}) or vector(0)", "instant": true}],
      "fieldConfig": {"defaults": {
        "decimals": 0,
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}
      }, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 9, "type": "timeseries", "title": "CPU-Auslastung",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))", "legendFormat": "CPU gesamt"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"fillOpacity": 15, "lineWidth": 2}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 10, "type": "timeseries", "title": "CPU-Temperatur",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max(node_thermal_zone_temp)", "legendFormat": "Temperatur"}],
      "fieldConfig": {"defaults": {
        "unit": "celsius", "custom": {"fillOpacity": 15, "lineWidth": 2, "thresholdsStyle": {"mode": "line+area"}},
        "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 80}]}
      }, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 11, "type": "timeseries", "title": "Arbeitsspeicher",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "Belegt"},
        {"refId": "B", "expr": "node_memory_MemTotal_bytes", "legendFormat": "Gesamt"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "custom": {"fillOpacity": 15, "lineWidth": 2}},
        "overrides": [{"matcher": {"id": "byName", "options": "Gesamt"}, "properties": [{"id": "custom.fillOpacity", "value": 0}, {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 6]}}]}]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 12, "type": "timeseries", "title": "Netzwerk",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "rate(node_network_receive_bytes_total{device=~\"eth0|wlan0\"}[$__rate_interval]) * 8", "legendFormat": "{{device}} empfangen"},
        {"refId": "B", "expr": "rate(node_network_transmit_bytes_total{device=~\"eth0|wlan0\"}[$__rate_interval]) * 8", "legendFormat": "{{device}} gesendet"}
      ],
      "fieldConfig": {"defaults": {"unit": "bps", "min": 0, "custom": {"fillOpacity": 10, "lineWidth": 2}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 13, "type": "timeseries", "title": "CPU pro Container",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[$__rate_interval]))", "legendFormat": "{{name}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "custom": {"fillOpacity": 0, "lineWidth": 2}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "sortBy": "Mean", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 14, "type": "timeseries", "title": "Arbeitsspeicher pro Container",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\"})", "legendFormat": "{{name}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "custom": {"fillOpacity": 0, "lineWidth": 2}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 15, "type": "bargauge", "title": "Speicherplatz",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|devtmpfs|overlay|squashfs|ramfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|devtmpfs|overlay|squashfs|ramfs\"})", "legendFormat": "{{mountpoint}}", "instant": true}],
      "fieldConfig": {"defaults": {
        "unit": "percent", "decimals": 0, "min": 0, "max": 100,
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 85}, {"color": "red", "value": 95}]}
      }, "overrides": []},
      "options": {"orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 16, "type": "timeseries", "title": "Antwortzeit der Website (aus dem Internet gemessen)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "probe_duration_seconds", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"fillOpacity": 0, "lineWidth": 2}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ]
}
