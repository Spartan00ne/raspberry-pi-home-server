[Unit]
Description=Raspberry-Pi-Metriken (vcgencmd) für node_exporter schreiben

[Service]
Type=oneshot
User=simeon
Group=video
RuntimeDirectory=pi-metrics
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/home/simeon/homepage/scripts/pi-metrics /run/pi-metrics
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/pi-metrics
PrivateTmp=yes
