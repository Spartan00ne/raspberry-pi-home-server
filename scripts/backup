#!/usr/bin/env bash
# Sichert den Zustand des Servers mit restic auf die externe Festplatte.
# Läuft täglich um 03:00 (homepage-backup.timer), Details in docs/backup.md.
#
# Gesichert werden nur Daten, die sich nicht aus Git und Ansible Vault neu
# erzeugen lassen: die Docker-Volumes von Grafana, Prometheus und Alertmanager.
#
# Ablauf:
#   1. Prüfen, ob die externe Platte eingehängt und das Repository lesbar ist.
#   2. Grafana und Prometheus kurz anhalten (konsistente SQLite-DB und TSDB).
#      Der Alertmanager läuft weiter, damit keine Alarme verloren gehen.
#      Ein trap startet sie in jedem Fall wieder.
#   3. restic backup, danach die Container sofort wieder starten.
#   4. Alte Snapshots ausdünnen: 7 tägliche, 4 wöchentliche, 6 monatliche;
#      sonntags zusätzlich prune (Speicher wirklich freigeben).
#   5. Ergebnis als Metrik für den node_exporter (Alarme BackupFehlgeschlagen
#      und BackupVeraltet).
#
# Aufruf: sudo scripts/backup [tag]   (Standard-Tag: auto; restore nutzt pre-restore)
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LOG_TAG=backup
# shellcheck source=scripts/backup-lib
source "$SCRIPT_DIR/backup-lib"

TAG="${1:-auto}"
START="$(date +%s)"

finish() {
  local rc=$?
  start_containers
  write_metrics backup homepage_backup "$(( rc == 0 ? 1 : 0 ))" "$(( $(date +%s) - START ))" || true
  if (( rc == 0 )); then
    log "Backup erfolgreich."
  else
    log "Backup FEHLGESCHLAGEN (Exit $rc)."
  fi
  exit "$rc"
}
trap finish EXIT

take_lock
require_repo

paths=()
for name in "${!BACKUP_VOLUMES[@]}"; do
  dir="$(volume_path "${BACKUP_VOLUMES[$name]}")"
  [[ -d "$dir" ]] || die "Volume fehlt: $dir"
  paths+=("$dir")
done

stop_containers "${BACKUP_STOP_CONTAINERS[@]}"
restic backup --host "$BACKUP_HOST" --tag "$TAG" "${paths[@]}"
start_containers

forget_args=(--host "$BACKUP_HOST" --keep-daily 7 --keep-weekly 4 --keep-monthly 6)
if [[ "$(date +%u)" == 7 ]]; then
  forget_args+=(--prune)
fi
restic forget "${forget_args[@]}"
